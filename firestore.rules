rules_version = '2';

// Per-user isolation: a signed-in user may read/write only their own documents
// under users/{uid}. Everything else is denied by default.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      // (Firestore natively caps documents at 1 MiB; the full project JSON fits.)
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
